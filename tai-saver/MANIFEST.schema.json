{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tai Saver snapshot manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "source_path": { "const": "ur0:tai" },
    "archive_class": {
      "type": "string",
      "enum": ["automatic", "known-good", "failed", "pre-restore"]
    },
    "completion_state": {
      "type": "string",
      "enum": ["complete", "incomplete", "verification-failed"]
    },
    "file_count": { "type": "integer", "minimum": 0 },
    "total_bytes": { "type": "integer", "minimum": 0 },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "relative_path": { "type": "string", "minLength": 1 },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        },
        "required": ["relative_path", "size_bytes", "sha256"]
      }
    },
    "notes": { "type": "string" }
  },
  "required": [
    "schema_version",
    "snapshot_id",
    "created_at",
    "source_path",
    "archive_class",
    "completion_state",
    "file_count",
    "total_bytes",
    "files"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tai Saver snapshot manifest",
  "description": "Integrity manifest written only for a complete, verified snapshot.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 95,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "created_at": { "type": "string", "format": "date-time" },
    "source_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1023,
      "description": "The source directory captured by the snapshot; ur0:tai on the Vita and a host path in tests."
    },
    "archive_class": {
      "type": "string",
      "enum": ["automatic", "known-good", "failed", "pre-restore"]
    },
    "completion_state": { "const": "complete" },
    "file_count": { "type": "integer", "minimum": 0, "maximum": 4096 },
    "total_bytes": { "type": "integer", "minimum": 0 },
    "files": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "relative_path": { "type": "string", "minLength": 1, "maxLength": 1023 },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        },
        "required": ["relative_path", "size_bytes", "sha256"]
      }
    },
    "notes": { "type": "string", "maxLength": 255 }
  },
  "required": [
    "schema_version",
    "snapshot_id",
    "created_at",
    "source_path",
    "archive_class",
    "completion_state",
    "file_count",
    "total_bytes",
    "files",
    "notes"
  ]
}

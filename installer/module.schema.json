{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rt:Settings Extended module manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "manifest_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([+-][A-Za-z0-9.-]+)?$"
    },
    "category": {
      "type": "string",
      "enum": [
        "settings",
        "service",
        "integration"
      ]
    },
    "minimum_framework": {
      "type": "string"
    },
    "maximum_framework": {
      "type": [
        "string",
        "null"
      ]
    },
    "minimum_firmware": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "minimum_version": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "minimum_version"
        ]
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "entry": {
      "type": "string"
    },
    "payload_root": {
      "type": "string"
    },
    "owned_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      }
    },
    "settings_schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "data_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "uninstall": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "remove_owned_files": {
          "type": "boolean",
          "const": true
        },
        "preserve_data_by_default": {
          "type": "boolean",
          "const": true
        },
        "run_script": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "remove_owned_files",
        "preserve_data_by_default"
      ]
    }
  },
  "required": [
    "manifest_version",
    "id",
    "name",
    "description",
    "version",
    "category",
    "minimum_framework",
    "minimum_firmware",
    "dependencies",
    "conflicts",
    "entry",
    "payload_root",
    "owned_paths",
    "data_paths",
    "uninstall"
  ]
}

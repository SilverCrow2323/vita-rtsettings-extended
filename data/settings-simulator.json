{
  "schemaVersion": 1,
  "profile": {
    "model": "PCH-1000",
    "display": "OLED",
    "firmware": "3.65",
    "hacks": "Ensō",
    "note": "Illustrative profile; the browser does not detect hardware."
  },
  "navigation": {
    "root": "sony",
    "rtRoot": "rt",
    "back": "stack-pop",

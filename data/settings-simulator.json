      "keyboard",
      "pointer",
      "touch"
    ],
    "viewport": {
      "width": 960,
      "height": 544,
      "aspectRatio": "16:9"
    }
  },
  "safety": {
    "mode": "simulation-only",
    "hardwareWrites": false,
    "pluginActivation": false,
    "storageWrites": false,

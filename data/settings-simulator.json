    },
    {
      "id": "overclock-manager",
      "members": [
        "PSVshell",
        "LOLIcon",
        "Oclock"
      ],
      "policy": "single-active-provider"
    },
    {
      "id": "quick-menu",
      "members": [
        "QuickMenuReborn",
        "Quick Menu Plus"
      ],
      "policy": "verify-version-before-selection"
    }
  ]

PREFIX ?= arm-vita-eabi-
CC := $(PREFIX)gcc
AR := $(PREFIX)ar
RANLIB := $(PREFIX)ranlib

CPPFLAGS += -DRTSE_PLATFORM_VITA -Iinclude -Isource/tai-saver
CFLAGS += -std=c99 -O2 -Wall -Wextra -Wpedantic -fno-strict-aliasing

OBJECTS := build-vita/tai_saver.o build-vita/sha256.o
LIBRARY := build-vita/libtai_saver.a

.PHONY: all clean
all: $(LIBRARY)

build-vita:
	mkdir -p $@

build-vita/tai_saver.o: source/tai-saver/tai_saver.c include/tai_saver.h source/tai-saver/sha256.h | build-vita
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

build-vita/sha256.o: source/tai-saver/sha256.c source/tai-saver/sha256.h | build-vita
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

$(LIBRARY): $(OBJECTS)
	$(AR) rcs $@ $(OBJECTS)
	$(RANLIB) $@

clean:
	rm -rf build-vita

PREFIX ?= arm-vita-eabi-
CC := $(PREFIX)gcc
AR := $(PREFIX)ar
RANLIB := $(PREFIX)ranlib

CPPFLAGS += -DRTSE_PLATFORM_VITA -Iinclude -Isource/tai-saver -Isource/boot-monitor -Isource/preferences -Isource/layout-profiles -Isettings-ui -Isettings-ui/metadata -Isource/plugin-inventory -Isource/plugin-compatibility -Isource/plugin-adapters -Isource/custom-assets
CFLAGS += -std=c99 -O2 -Wall -Wextra -Wpedantic -fno-strict-aliasing

OBJECTS := build-vita/tai_saver.o build-vita/sha256.o build-vita/boot_journal.o build-vita/preferences.o build-vita/layout_profiles.o build-vita/preferences_ui.o build-vita/settings_metadata.o build-vita/settings_screen.o build-vita/profile_manager.o build-vita/module_controls.o build-vita/service_manager.o build-vita/plugin_inventory.o build-vita/plugin_compatibility.o build-vita/plugin_control_centre.o build-vita/storage_devices.o build-vita/wifi_turbo_adapter.o build-vita/custom_assets.o
LIBRARY := build-vita/librtsettings.a

.PHONY: all clean
all: $(LIBRARY)

build-vita:
	mkdir -p $@

build-vita/tai_saver.o: source/tai-saver/tai_saver.c include/tai_saver.h source/tai-saver/sha256.h | build-vita
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

build-vita/sha256.o: source/tai-saver/sha256.c source/tai-saver/sha256.h | build-vita
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

build-vita/boot_journal.o: source/boot-monitor/boot_journal.c include/boot_journal.h include/tai_saver.h | build-vita
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

build-vita/preferences.o: source/preferences/preferences.c include/preferences.h | build-vita
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

build-vita/layout_profiles.o: source/layout-profiles/layout_profiles.c include/layout_profiles.h include/preferences.h | build-vita
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

build-vita/preferences_ui.o: settings-ui/preferences_ui.c settings-ui/preferences_ui.h include/preferences.h include/layout_profiles.h | build-vita
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

build-vita/settings_metadata.o: settings-ui/metadata/settings_metadata.c settings-ui/metadata/settings_metadata.h include/preferences.h | build-vita
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

build-vita/service_manager.o: settings-ui/service_manager.c settings-ui/service_manager.h | build-vita
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

build-vita/module_controls.o: settings-ui/module_controls.c settings-ui/module_controls.h include/preferences.h | build-vita
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

build-vita/profile_manager.o: settings-ui/profile_manager.c settings-ui/profile_manager.h settings-ui/preferences_ui.h include/layout_profiles.h | build-vita
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

build-vita/settings_screen.o: settings-ui/settings_screen.c settings-ui/settings_screen.h settings-ui/preferences_ui.h settings-ui/metadata/settings_metadata.h | build-vita
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

build-vita/plugin_inventory.o: source/plugin-inventory/plugin_inventory.c include/plugin_inventory.h | build-vita
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

build-vita/plugin_compatibility.o: source/plugin-compatibility/plugin_compatibility.c include/plugin_compatibility.h | build-vita
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

build-vita/wifi_turbo_adapter.o: source/plugin-adapters/wifi_turbo_adapter.c include/wifi_turbo_adapter.h | build-vita
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

build-vita/plugin_control_centre.o: settings-ui/plugin_control_centre.c settings-ui/plugin_control_centre.h include/plugin_inventory.h include/plugin_compatibility.h | build-vita
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

build-vita/storage_devices.o: settings-ui/storage_devices.c settings-ui/storage_devices.h | build-vita
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

$(LIBRARY): $(OBJECTS)
	$(AR) rcs $@ $(OBJECTS)
	$(RANLIB) $@

clean:
	rm -rf build-vita
